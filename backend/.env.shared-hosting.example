APP_NAME="ERP Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Addis_Ababa
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=error

# Shared Hosting Database (Default MySQL/MariaDB for cPanel)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yourcpanel_erp
DB_USERNAME=yourcpanel_erpuser
DB_PASSWORD=your_secure_password_here

# File-based Drivers (No Redis Required for Shared Hosts)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Mail Setup (Use your cPanel SMTP or transactional mail provider)
MAIL_MAILER=smtp
MAIL_HOST=mail.your-domain.com
MAIL_PORT=465
MAIL_USERNAME=noreply@your-domain.com
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# JWT Authentication Secret (Generate with: php artisan jwt:secret)
JWT_SECRET=
JWT_TTL=120
JWT_REFRESH_TTL=20160

# Default Currency & Tenancy
APP_CURRENCY=ETB
